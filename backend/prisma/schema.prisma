// schema.prisma — Arrowhead Access core data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  OFFICE
  REP_COMPANY
}

enum StaffRole {
  ADMIN
  STAFF
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  DOMAIN_MATCH
  ID_UPLOAD
}

enum SlotStatus {
  OPEN
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum SlotEventType {
  REP_VISIT
  LUNCH
  STAFF_TRAINING
  OFFICE_CLOSED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  COMPLETED
  NO_SHOW
}

enum SubscriptionPlan {
  OFFICE
  REP
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          OrgType
  billingEmail  String
  createdAt     DateTime @default(now())

  locations     Location[]
  reps          Rep[]
  subscription  Subscription?
}

model Location {
  id                          String   @id @default(cuid())
  organizationId              String
  organization                Organization @relation(fields: [organizationId], references: [id])
  name                        String
  address                     String
  timezone                    String
  maxVisitsPerRepPerMonth     Int      @default(1)
  maxVisitsPerCompanyPerMonth Int      @default(2)
  createdAt                   DateTime @default(now())

  staff  StaffUser[]
  slots  Slot[]
  policy OfficePolicy?
}

model OfficePolicy {
  id                          String   @id @default(cuid())
  locationId                  String   @unique
  location                    Location @relation(fields: [locationId], references: [id])
  maxVisitsPerRepPerMonth     Int      @default(1)
  maxVisitsPerCompanyPerMonth Int      @default(2)
  confirmationDeadlineHours   Int      @default(48)
  closedDays                  DayOfWeek[]
  closedTimeStart             String?  // HH:MM format, null = no blocked time today
  closedTimeEnd               String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model RecurringSlotTemplate {
  id           String     @id @default(cuid())
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])
  daysOfWeek   DayOfWeek[]
  startTime    String     // HH:MM format
  endTime      String     // HH:MM format
  eventType    SlotEventType
  endsAt       DateTime?  // null = recurring forever
  createdAt    DateTime   @default(now())

  @@index([locationId])
}

model StaffUser {
  id           String    @id @default(cuid())
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())

  createdSlots Slot[]
}

// --- Manufacturer catalog (like RxVantage's company/product picker) -------

model ManufacturerCompany {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
  reps      Rep[]
}

model Product {
  id         String              @id @default(cuid())
  companyId  String
  company    ManufacturerCompany @relation(fields: [companyId], references: [id])
  name       String
  createdAt  DateTime            @default(now())

  reps       Rep[]               @relation("RepProducts")

  @@unique([companyId, name])
}

model Rep {
  id                   String              @id @default(cuid())
  organizationId       String?
  organization         Organization?       @relation(fields: [organizationId], references: [id])
  email                String              @unique
  name                 String
  companyName          String
  passwordHash         String
  verificationStatus   VerificationStatus  @default(UNVERIFIED)
  verificationMethod   VerificationMethod?
  createdAt            DateTime            @default(now())

  // Profile (RxVantage-style personal info)
  title                String?
  phone                String?
  specialties          String[]            @default([])

  // Manufacturer catalog selection
  manufacturerCompanyId String?
  manufacturerCompany   ManufacturerCompany? @relation(fields: [manufacturerCompanyId], references: [id])
  products             Product[]           @relation("RepProducts")

  // Billing (Stripe) — reps are the only paying side of the marketplace
  isFoundingRep        Boolean             @default(false)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  billingCycle         BillingCycle?
  subscriptionStatus   SubscriptionStatus  @default(TRIALING)
  trialEndsAt          DateTime?

  verificationRequests VerificationRequest[]
  bookings             Booking[]
  transfersSent        BookingTransfer[]   @relation("TransfersSent")
  transfersReceived    BookingTransfer[]   @relation("TransfersReceived")
}

model VerificationRequest {
  id              String              @id @default(cuid())
  repId           String
  rep             Rep                 @relation(fields: [repId], references: [id])
  method          VerificationMethod
  submittedDomain String?
  idDocumentUrl   String?
  status          VerificationStatus  @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
}

model KnownManufacturerDomain {
  id     String @id @default(cuid())
  domain String @unique
}

model Slot {
  id               String         @id @default(cuid())
  locationId       String
  location         Location       @relation(fields: [locationId], references: [id])
  startTime        DateTime
  endTime          DateTime
  status           SlotStatus     @default(OPEN)
  eventType        SlotEventType  @default(REP_VISIT)
  createdByStaffId String?
  createdByStaff   StaffUser?     @relation(fields: [createdByStaffId], references: [id])
  createdAt        DateTime       @default(now())

  booking Booking?

  @@index([locationId, startTime])
}

model Booking {
  id          String        @id @default(cuid())
  slotId      String        @unique
  slot        Slot          @relation(fields: [slotId], references: [id])
  repId       String
  rep         Rep           @relation(fields: [repId], references: [id])
  topic       String?
  status      BookingStatus @default(REQUESTED)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?

  transfers   BookingTransfer[]

  @@index([repId, status])
}

model BookingTransfer {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id])
  fromRepId  String
  fromRep    Rep            @relation("TransfersSent", fields: [fromRepId], references: [id])
  toRepId    String
  toRep      Rep            @relation("TransfersReceived", fields: [toRepId], references: [id])
  status     TransferStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?

  @@index([toRepId, status])
  @@index([fromRepId])
}

model Subscription {
  id                   String              @id @default(cuid())
  organizationId       String              @unique
  organization         Organization        @relation(fields: [organizationId], references: [id])
  stripeSubscriptionId String              @unique
  plan                 SubscriptionPlan
  unitCount            Int
  billingCycle         BillingCycle
  status               SubscriptionStatus  @default(TRIALING)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}
