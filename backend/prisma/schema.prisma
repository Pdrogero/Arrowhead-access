// schema.prisma — Arrowhead Access core data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  OFFICE
  REP_COMPANY
}

enum StaffRole {
  ADMIN
  STAFF
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  DOMAIN_MATCH
  ID_UPLOAD
}

enum SlotStatus {
  OPEN
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum SlotEventType {
  REP_VISIT
  LUNCH
  BREAKFAST
  QUICK_VISIT
  COFFEE_SNACK
  STAFF_TRAINING
  OFFICE_CLOSED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum RescheduleDecision {
  ACCEPTED
  DECLINED
}

enum CancelledBy {
  OFFICE
  REP
}

enum SubscriptionPlan {
  OFFICE
  REP
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          OrgType
  billingEmail  String
  createdAt     DateTime @default(now())

  locations     Location[]
  reps          Rep[]
  subscription  Subscription?
  staff         StaffUser[]
}

model Location {
  id                          String   @id @default(cuid())
  organizationId              String
  organization                Organization @relation(fields: [organizationId], references: [id])
  name                        String
  address                     String
  // Optional contact for this specific location — set when a location is
  // added on behalf of a different manager than the org's main admin login,
  // so that person gets notified a location was set up for them.
  managerEmail                String?
  // Contact number shown to reps on the office detail screen — optional,
  // since existing locations predate this field.
  phone                       String?
  timezone                    String
  maxVisitsPerRepPerMonth     Int      @default(1)
  maxVisitsPerCompanyPerMonth Int      @default(2)
  createdAt                   DateTime @default(now())
  // "2026-09" style key for the month the new-month schedule-setup email
  // was last sent, so the daily cron only sends it once per month.
  lastMonthlyReminderMonth    String?

  staff  StaffUser[]
  slots  Slot[]
  policy OfficePolicy?
  recurringSlotTemplates RecurringSlotTemplate[]
  employees OfficeEmployee[]
  conversations Conversation[]
  literatureItems LiteratureItem[]
  favoritedBy FavoriteLocation[]
}

// A rep's saved shortlist of offices they like, shown on their profile —
// separate from booking history, since they may want to favorite an office
// before ever booking there.
model FavoriteLocation {
  id         String   @id @default(cuid())
  repId      String
  rep        Rep      @relation(fields: [repId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([repId, locationId])
  @@index([repId])
}

// A simple staff directory the office maintains, visible to reps who've
// booked a visit there — so they know who works at the office.
model OfficeEmployee {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String
  title      String?
  npi        String?
  createdAt  DateTime @default(now())

  @@index([locationId])
}

model OfficePolicy {
  id                          String   @id @default(cuid())
  locationId                  String   @unique
  location                    Location @relation(fields: [locationId], references: [id])
  maxVisitsPerRepPerMonth     Int      @default(1)
  maxVisitsPerCompanyPerMonth Int      @default(2)
  // Free text (e.g. "48 hours", "2 business days", "by 5pm the day
  // before") — a dropdown of common hour presets fills this in, but the
  // office can type something more specific too, so it's not strictly
  // numeric.
  confirmationDeadline        String?
  closedDays                  DayOfWeek[]
  closedTimeStart             String?  // HH:MM format, null = no blocked time today
  closedTimeEnd               String?
  // Standing allergy/dietary notes for the office, shown to reps as
  // general context (separate from the per-lunch allergy notes on Slot).
  generalAllergyNotes         String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model RecurringSlotTemplate {
  id           String     @id @default(cuid())
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])
  daysOfWeek   DayOfWeek[]
  startTime    String     // HH:MM format
  endTime      String     // HH:MM format
  eventType    SlotEventType
  endsAt       DateTime?  // null = recurring forever
  createdAt    DateTime   @default(now())

  @@index([locationId])
}

model StaffUser {
  id             String        @id @default(cuid())
  // The location this login is currently "pointed at" — same field used
  // everywhere in the app to scope what this staff account can see/edit.
  // Switching locations (for orgs with more than one) updates this in
  // place rather than requiring a separate login per location.
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  email          String        @unique
  passwordHash   String
  role           StaffRole     @default(STAFF)
  createdAt      DateTime      @default(now())

  createdSlots   Slot[]
}

// --- Manufacturer catalog (like RxVantage's company/product picker) -------

model ManufacturerCompany {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
  reps      Rep[]
}

model Product {
  id         String              @id @default(cuid())
  companyId  String
  company    ManufacturerCompany @relation(fields: [companyId], references: [id])
  name       String
  createdAt  DateTime            @default(now())

  reps       Rep[]               @relation("RepProducts")

  @@unique([companyId, name])
}

model Rep {
  id                   String              @id @default(cuid())
  organizationId       String?
  organization         Organization?       @relation(fields: [organizationId], references: [id])
  email                String              @unique
  name                 String
  companyName          String
  passwordHash         String
  verificationStatus   VerificationStatus  @default(UNVERIFIED)
  verificationMethod   VerificationMethod?
  createdAt            DateTime            @default(now())

  // Profile (RxVantage-style personal info)
  title                String?
  roleFunction         String?
  phone                String?
  mobilePhone          String?
  additionalEmail      String?
  credentials          String?
  relationshipToCompany String?
  profileImageUrl      String?             // data: URL, resized/compressed client-side
  specialties          String[]            @default([])

  // Manufacturer catalog selection
  manufacturerCompanyId String?
  manufacturerCompany   ManufacturerCompany? @relation(fields: [manufacturerCompanyId], references: [id])
  products             Product[]           @relation("RepProducts")

  // Billing (Stripe) — reps are the only paying side of the marketplace
  isFoundingRep        Boolean             @default(false)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  billingCycle         BillingCycle?
  subscriptionStatus   SubscriptionStatus  @default(TRIALING)
  cancelAtPeriodEnd    Boolean             @default(false)
  trialEndsAt          DateTime?
  // Set true the first time a trial actually starts (checkout completes
  // with a trialing subscription) — checked at checkout so a rep who
  // cancels during (or after) their trial can't just re-subscribe for
  // another free 14 days.
  hasUsedTrial         Boolean             @default(false)
  currentPeriodEnd     DateTime?           // next renewal/charge date, synced from Stripe
  renewalReminder30dSent Boolean           @default(false)
  renewalReminder7dSent  Boolean           @default(false)
  renewalReminder1dSent  Boolean           @default(false)
  // "2026-09" style key for the month the new-month booking-reminder email
  // was last sent, so the daily cron only sends it once per month.
  lastMonthlyReminderMonth String?

  // Private token embedded in this rep's calendar subscription URL, so
  // Google/Apple Calendar can fetch their bookings.ics feed without logging in.
  calendarToken        String?             @unique

  verificationRequests VerificationRequest[]
  bookings             Booking[]
  transfersSent        BookingTransfer[]   @relation("TransfersSent")
  transfersReceived    BookingTransfer[]   @relation("TransfersReceived")
  conversations        Conversation[]
  literatureItems      LiteratureItem[]
  marketingMaterials   RepMarketingMaterial[]
  officeInterestRequests OfficeInterestRequest[]
  favoriteLocations    FavoriteLocation[]
}

// A rep searched for an office that isn't on Arrowhead Access yet (or has
// no open slots) and asked to be emailed once that office signs up.
model OfficeInterestRequest {
  id         String   @id @default(cuid())
  repId      String
  rep        Rep      @relation(fields: [repId], references: [id], onDelete: Cascade)
  officeName String
  // Filled in when the rep picked a suggestion from the address-lookup
  // autocomplete instead of just typing a bare name — gives whoever
  // follows up on this request a real address to go on.
  address    String?
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([officeName])
  @@index([repId])
}

// A rep's saved library of marketing files (brochures, case studies, etc.)
// uploaded once and then picked from when sending literature to an office,
// instead of re-uploading the same file every time.
model RepMarketingMaterial {
  id        String   @id @default(cuid())
  repId     String
  rep       Rep      @relation(fields: [repId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())

  @@index([repId])
}

model VerificationRequest {
  id              String              @id @default(cuid())
  repId           String
  rep             Rep                 @relation(fields: [repId], references: [id])
  method          VerificationMethod
  submittedDomain String?
  idDocumentUrl   String?
  status          VerificationStatus  @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
}

model KnownManufacturerDomain {
  id     String @id @default(cuid())
  domain String @unique
}

model Slot {
  id               String         @id @default(cuid())
  locationId       String
  location         Location       @relation(fields: [locationId], references: [id])
  startTime        DateTime
  endTime          DateTime
  status           SlotStatus     @default(OPEN)
  eventType        SlotEventType  @default(REP_VISIT)
  createdByStaffId String?
  createdByStaff   StaffUser?     @relation(fields: [createdByStaffId], references: [id])
  createdAt        DateTime       @default(now())

  // Lunch order details — only meaningful when eventType is LUNCH. The
  // office fills these in (at posting time or later); if repHandlesOrder
  // is true the office is asking the rep to place the order themselves,
  // and headCount/allergyNotes are still useful for the rep to know what
  // to order for.
  headCount        Int?
  allergyNotes     String?
  foodOrderNotes   String?
  repHandlesOrder  Boolean        @default(false)

  booking Booking?

  @@index([locationId, startTime])
}

model Booking {
  id          String        @id @default(cuid())
  slotId      String        @unique
  slot        Slot          @relation(fields: [slotId], references: [id])
  repId       String
  rep         Rep           @relation(fields: [repId], references: [id])
  topic       String?
  status      BookingStatus @default(REQUESTED)
  requestedAt DateTime      @default(now())
  decidedAt   DateTime?
  // Set when either side cancels a confirmed visit — required so the
  // other side gets a real explanation in the notification email.
  cancelReason String?
  // Which side cancelled — decides who owes a response to the suggested
  // reschedule below (the other side).
  cancelledBy CancelledBy?
  // Optional alternative time the cancelling side proposes — just a
  // suggestion until the other side responds below.
  suggestedRescheduleAt DateTime?
  // The other side's answer to that suggestion. Accepting creates a
  // brand new slot + booking (rescheduledBookingId points to it);
  // declining just records their message.
  rescheduleResponse        RescheduleDecision?
  rescheduleResponseMessage String?
  rescheduleRespondedAt     DateTime?
  rescheduledBookingId      String?

  // Only meaningful for lunch-type slots — tracks the 1-day-out and
  // day-of reminder emails so the daily cron doesn't resend them.
  lunchReminder1dSent  Boolean @default(false)
  lunchReminderDaySent Boolean @default(false)

  transfers   BookingTransfer[]
  attendees   VisitAttendee[]
  reviews     VisitReview[]

  @@index([repId, status])
}

enum ReviewAuthorType {
  REP
  OFFICE
}

// Mutual 1-5 rating + optional comment, one per side per confirmed visit.
model VisitReview {
  id         String           @id @default(cuid())
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id])
  authorType ReviewAuthorType
  authorId   String
  rating     Int
  comment    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([bookingId, authorType])
  @@index([bookingId])
}

// Attendee list a rep logs after a visit — for their own expense-report
// records. NPI is optional (Concur already offers NPI lookup separately).
model VisitAttendee {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  firstName String
  lastName  String
  npi       String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model BookingTransfer {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id])
  fromRepId  String
  fromRep    Rep            @relation("TransfersSent", fields: [fromRepId], references: [id])
  // The email the transfer was offered to. Set on every transfer created
  // after this field was added; nullable only so existing rows (which
  // predate it and always have toRepId set) don't block the migration.
  // toRepId is filled in once a matching rep account exists: either one
  // already did when the transfer was offered, or a new signup with this
  // email claims it (see /api/auth/rep/signup).
  toRepEmail String?
  toRepId    String?
  toRep      Rep?           @relation("TransfersReceived", fields: [toRepId], references: [id])
  status     TransferStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?

  @@index([toRepId, status])
  @@index([fromRepId])
  @@index([toRepEmail, status])
}

model Subscription {
  id                   String              @id @default(cuid())
  organizationId       String              @unique
  organization         Organization        @relation(fields: [organizationId], references: [id])
  stripeSubscriptionId String              @unique
  plan                 SubscriptionPlan
  unitCount            Int
  billingCycle         BillingCycle
  status               SubscriptionStatus  @default(TRIALING)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

// --- In-app messaging: one conversation per (rep, office location) pair ---

model Conversation {
  id         String    @id @default(cuid())
  repId      String
  rep        Rep       @relation(fields: [repId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())

  messages   Message[]

  @@unique([repId, locationId])
}

enum MessageSenderType {
  REP
  OFFICE
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  senderType     MessageSenderType
  senderId       String
  body           String
  createdAt      DateTime          @default(now())

  // Set when the other side of the conversation opens it after this
  // message was sent. Used to send a single idle-unread reminder email
  // (reminderSent) if it's still unread after 24 hours.
  readAt         DateTime?
  reminderSent   Boolean           @default(false)

  @@index([conversationId, createdAt])
}

// --- Literature & samples a rep sends an office to review ------------------

enum LiteratureStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model LiteratureItem {
  id                String                 @id @default(cuid())
  repId             String
  rep               Rep                    @relation(fields: [repId], references: [id])
  locationId        String
  location          Location               @relation(fields: [locationId], references: [id])
  title             String
  description       String?
  linkUrl           String?
  attachments       LiteratureAttachment[]
  status            LiteratureStatus       @default(PENDING)
  reviewedByStaffId String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())

  @@index([locationId, status])
  @@index([repId])
}

// A single uploaded file (case study, brochure page, etc.) attached to a
// LiteratureItem. An item can have several of these, letting a rep send a
// small set of documents/images in one submission.
model LiteratureAttachment {
  id               String         @id @default(cuid())
  literatureItemId String
  literatureItem   LiteratureItem @relation(fields: [literatureItemId], references: [id], onDelete: Cascade)
  url              String
  createdAt        DateTime       @default(now())

  @@index([literatureItemId])
}
