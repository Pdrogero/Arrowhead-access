// schema.prisma — Arrowhead Access core data model
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  OFFICE
  REP_COMPANY
}

enum StaffRole {
  ADMIN
  STAFF
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  DOMAIN_MATCH
  ID_UPLOAD
}

enum SlotStatus {
  OPEN
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  COMPLETED
  
